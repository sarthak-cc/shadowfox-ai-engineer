# Required - free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Models (tried in order; a backup is also asked if the first is slow)
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
HEDGE_AFTER_S=6
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
EMBED_PER_MINUTE=90

# Retrieval
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=5
RERANK_MIN_SCORE=0.02
GROUNDEDNESS_THRESHOLD=0.75
